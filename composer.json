{
    "name": "dbseller/valitron",
    "type": "library",
    "description": "Simple, elegant, stand-alone validation library with NO dependencies",
    "keywords": [
        "validation",
        "validator",
        "valid"
    ],
    "homepage": "https://github.com/DBSeller/valitron",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Vance Lucas",
            "email": "vance@vancelucas.com",
            "homepage": "https://www.vancelucas.com"
        },
        {
            "name": "Gabriel Morgado",
            "email": "gabriel.morgado@dbseller.com.br"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": ">=4.8.35"
    },
    "suggest": {
        "ext-mbstring": "It can support the multiple bytes string length."
    },
    "autoload": {
        "psr-4": {
            "Valitron\\": "src/Valitron"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Valitron\\": "tests/Valitron"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    },
    "replace": {
        "vlucas/valitron": "self.version"
    },
    "version": "1.4.12"
}
